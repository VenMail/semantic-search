{
  "name": "venmail/laravel-semantic-search",
  "version": "0.2.4",
  "description": "Laravel semantic search package with static code analysis and context-aware query building.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "semantic search",
    "vector search",
    "natural language",
    "eloquent",
    "query builder",
    "multilingual search",
    "ai search"
  ],
  "require": {
    "php": "^8.1",
    "illuminate/support": "^9.0|^10.0|^11.0|^12.0",
    "illuminate/cache": "^9.0|^10.0|^11.0|^12.0",
    "illuminate/database": "^9.0|^10.0|^11.0|^12.0",
    "symfony/finder": "^5.4|^6.0|^7.0|^8.0",
    "symfony/string": "^5.4|^6.0|^7.0|^8.0",
    "nesbot/carbon": "^2.0|^3.0"
  },
  "autoload": {
    "psr-4": {
      "Venmail\\SemanticSearch\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Venmail\\SemanticSearch\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "orchestra/testbench": "^8.0",
    "laravel/legacy-factories": "^1.3"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Venmail\\SemanticSearch\\SemanticSearchServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
