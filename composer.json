{
  "name": "venmail/laravel-semantic-search",
  "description": "Laravel semantic search package with static code analysis and context-aware query building.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "illuminate/support": "^9.0|^10.0|^11.0",
    "illuminate/cache": "^9.0|^10.0|^11.0",
    "illuminate/database": "^9.0|^10.0|^11.0",
    "symfony/finder": "^5.4|^6.0",
    "symfony/string": "^5.4|^6.0",
    "nesbot/carbon": "^2.0|^3.0"
  },
  "autoload": {
    "psr-4": {
      "Venmail\\\\SemanticSearch\\\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Venmail\\\\SemanticSearch\\\\Tests\\\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "orchestra/testbench": "^8.0"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Venmail\\\\SemanticSearch\\\\SemanticSearchServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
